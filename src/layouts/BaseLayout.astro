---
import '../styles/tokens.css';
import Header from '../components/Header.astro';
const { title = 'Misha Narbekov — AI-assisted portfolio', description = 'A privacy-aware portfolio about practical AI-assisted building, systems thinking, and useful proof-of-work projects.' } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('b032-theme');
        const theme = stored || 'dark';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <div class="dark-shell">
      <div class="site-shell">
        <Header />
        <slot />
      </div>
    </div>
  </body>
</html>
