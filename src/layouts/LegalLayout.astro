---
import '../styles/tokens.css';
const { title = 'Convertly FX', description = 'Convertly FX' } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('b032-theme');
        const theme = stored || 'dark';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <div class="dark-shell">
      <div class="site-shell legal-shell">
        <header class="legal-header">
          <a class="brand" href="/" aria-label="Mikhail Narbekov home"><span>MN</span><small>mikhailnarbekov.com</small></a>
        </header>
        <main class="legal">
          <slot />
        </main>
        <footer class="footer legal-footer"><span>© 2026 Mikhail Narbekov. All rights reserved.</span></footer>
      </div>
    </div>
  </body>
</html>

<style>
  .legal-shell { max-width: 780px; }
  .legal-header { padding: 6px 0 40px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; width: fit-content; }
  .brand span { display: grid; place-items: center; width: 34px; height: 34px; border: 1px solid var(--accent-line); border-radius: 50%; color: var(--title); font-family: var(--font-display); font-size: .85rem; letter-spacing: -.04em; }
  .brand small { color: var(--muted); font-size: .68rem; letter-spacing: .14em; text-transform: uppercase; }
  .legal :global(.eyebrow) { color: var(--accent); font-size: .72rem; letter-spacing: .18em; text-transform: uppercase; font-weight: 700; }
  .legal :global(h1) { margin: 14px 0 8px; color: var(--title); font-family: var(--font-display); font-size: clamp(2rem, 5vw, 2.65rem); font-weight: 400; letter-spacing: -.045em; line-height: 1.08; }
  .legal :global(.effective) { color: var(--muted); font-size: .92rem; margin: 0 0 30px; }
  .legal :global(h2) { margin: 34px 0 10px; color: var(--title); font-family: var(--font-display); font-size: 1.4rem; font-weight: 400; letter-spacing: -.03em; }
  .legal :global(p) { color: var(--text-soft); font-size: 1.02rem; margin: 0 0 16px; overflow-wrap: anywhere; }
  .legal :global(ul) { color: var(--text-soft); font-size: 1.02rem; margin: 0 0 16px; padding-left: 20px; }
  .legal :global(li) { margin: 0 0 8px; }
  .legal :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; overflow-wrap: anywhere; }
  .legal-footer { margin-top: 72px; padding: 40px 0 18px; }
  @media (max-width: 860px) {
    .site-shell.legal-shell { padding: 42px 16px 42px; }
    .legal :global(p), .legal :global(li) { font-size: .98rem; }
  }
</style>
