---
const {
  title = 'Everyday Stoic',
  description = 'Everyday Stoic — a new piece of Stoic wisdom, every day of the year.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/everyday-stoic/icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        --bg: #f5f0e6;
        --surface: #fbf8f1;
        --ink: #2a2622;
        --ink-muted: #6b6155;
        --accent: #b23a31;
        --hairline: #e7decb;
        --serif: 'Cormorant Garamond', Georgia, serif;
        --sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      }
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: var(--sans);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }
      .shell { max-width: 1040px; margin: 0 auto; padding: 0 24px; }
      .topbar {
        display: flex; align-items: center; gap: 12px;
        padding: 26px 0; border-bottom: 1px solid var(--hairline);
      }
      .topbar img { width: 38px; height: 38px; border-radius: 9px; }
      .topbar .wordmark {
        font-family: var(--serif); font-weight: 600; font-size: 1.28rem;
        letter-spacing: -0.01em; color: var(--ink);
      }
      .topbar .home {
        margin-left: auto; color: var(--ink-muted); text-decoration: none;
        font-size: 0.82rem; letter-spacing: 0.06em; text-transform: uppercase;
      }
      .topbar .home:hover { color: var(--accent); }
      footer.site {
        border-top: 1px solid var(--hairline); margin-top: 88px;
        padding: 32px 0 48px; color: var(--ink-muted); font-size: 0.88rem;
      }
      footer.site .links { display: flex; flex-wrap: wrap; gap: 20px; margin-bottom: 14px; }
      footer.site a { color: var(--ink-muted); text-decoration: none; }
      footer.site a:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
    </style>
  </head>
  <body>
    <header class="shell topbar">
      <img src="/everyday-stoic/icon.png" alt="Everyday Stoic app icon" />
      <span class="wordmark">Everyday Stoic</span>
      <a class="home" href="/">mikhailnarbekov.com</a>
    </header>
    <slot />
    <footer class="site">
      <div class="shell">
        <div class="links">
          <a href="/everyday-stoic">Home</a>
          <a href="/everyday-stoic/privacy">Privacy</a>
          <a href="/everyday-stoic/support">Support</a>
          <a href="mailto:support@mikhailnarbekov.com">support@mikhailnarbekov.com</a>
        </div>
        <span>© 2026 Mikhail Narbekov. Everyday Stoic is a free iPhone app.</span>
      </div>
    </footer>
  </body>
</html>
