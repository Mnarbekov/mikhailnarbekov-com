                <text x="86" y="33" text-anchor="middle" font-size="9" fill="#8f9aaa" letter-spacing="1.4">VISUAL · TYPE</text>
              </g>
            </g>
          </g>

          <g transform="translate(432 320)">
            <rect x="0" y="0" width="400" height="74" rx="14" fill="rgba(159,203,255,.04)" stroke="rgba(159,203,255,.32)" stroke-width="1"/>
            <text x="14" y="22" font-family="'SFMono-Regular', Consolas, monospace" font-size="9.5" fill="#9fcbff" letter-spacing="1.6">THINKING</text>
            <g transform="translate(14 36)">
              <rect x="0" y="0" width="372" height="26" rx="9" fill="rgba(226,236,246,.04)" stroke="rgba(226,236,246,.18)" stroke-width="1"/>
              <text x="186" y="17" text-anchor="middle" font-family="Inter, system-ui, sans-serif" font-size="11" fill="#f2f7ff">Analyst · brainstorm partner</text>
            </g>
          </g>

          <g transform="translate(432 410)">
            <rect x="0" y="0" width="400" height="92" rx="14" fill="rgba(159,203,255,.04)" stroke="rgba(159,203,255,.32)" stroke-width="1"/>
            <text x="14" y="22" font-family="'SFMono-Regular', Consolas, monospace" font-size="9.5" fill="#9fcbff" letter-spacing="1.6">LIFE</text>
            <g font-family="Inter, system-ui, sans-serif" font-size="11" fill="#f2f7ff">
              <g transform="translate(14 36)">
                <rect x="0" y="0" width="118" height="44" rx="9" fill="rgba(226,236,246,.04)" stroke="rgba(226,236,246,.18)" stroke-width="1"/>
                <text x="59" y="18" text-anchor="middle">Health</text>
                <text x="59" y="33" text-anchor="middle" font-size="9" fill="#8f9aaa" letter-spacing="1.4">SLEEP · TRAIN</text>
              </g>
              <g transform="translate(140 36)">
                <rect x="0" y="0" width="118" height="44" rx="9" fill="rgba(226,236,246,.04)" stroke="rgba(226,236,246,.18)" stroke-width="1"/>
                <text x="59" y="18" text-anchor="middle">Finance</text>
                <text x="59" y="33" text-anchor="middle" font-size="9" fill="#8f9aaa" letter-spacing="1.4">ANALYSIS</text>
              </g>
              <g transform="translate(266 36)">
                <rect x="0" y="0" width="120" height="44" rx="9" fill="rgba(226,236,246,.04)" stroke="rgba(226,236,246,.18)" stroke-width="1"/>
                <text x="60" y="18" text-anchor="middle">Coach</text>
                <text x="60" y="33" text-anchor="middle" font-size="9" fill="#8f9aaa" letter-spacing="1.4">PERSPECTIVE</text>
              </g>
            </g>
          </g>

          <g transform="translate(432 510)">
            <rect x="0" y="0" width="400" height="74" rx="14" fill="rgba(159,203,255,.04)" stroke="rgba(159,203,255,.32)" stroke-width="1"/>
            <text x="14" y="22" font-family="'SFMono-Regular', Consolas, monospace" font-size="9.5" fill="#9fcbff" letter-spacing="1.6">HIRING</text>
            <g transform="translate(14 36)">
              <rect x="0" y="0" width="372" height="26" rx="9" fill="rgba(226,236,246,.04)" stroke="rgba(226,236,246,.18)" stroke-width="1"/>
              <text x="186" y="17" text-anchor="middle" font-family="Inter, system-ui, sans-serif" font-size="11" fill="#f2f7ff">HR — adds specialists when a gap appears</text>
            </g>
          </g>

          <g transform="translate(880 100)">
            <rect x="0" y="0" width="270" height="220" rx="14" fill="rgba(255,200,140,.04)" stroke="rgba(255,200,140,.4)" stroke-width="1.2"/>
            <text x="14" y="22" font-family="'SFMono-Regular', Consolas, monospace" font-size="9.5" fill="rgba(255,200,140,.85)" letter-spacing="1.6">SHARED TOOLS</text>
            <g font-family="Inter, system-ui, sans-serif" font-size="11.5" fill="#f2f7ff">
              <g transform="translate(14 42)">
                <text x="0" y="0" font-family="Georgia, serif" font-size="14" fill="#f8fbff">Azure</text>
                <text x="0" y="18" font-size="11" fill="#cfd6e0">LLM endpoints · n8n container</text>
              </g>
              <g transform="translate(14 92)">
                <text x="0" y="0" font-family="Georgia, serif" font-size="14" fill="#f8fbff">n8n on Azure</text>
                <text x="0" y="18" font-size="11" fill="#cfd6e0">scheduled workflows · webhooks</text>
              </g>
              <g transform="translate(14 142)">
                <text x="0" y="0" font-family="Georgia, serif" font-size="14" fill="#f8fbff">GitHub</text>
                <text x="0" y="18" font-size="11" fill="#cfd6e0">code · issues · CI · MCP</text>
              </g>
              <g transform="translate(14 192)">
                <text x="0" y="0" font-family="Georgia, serif" font-size="13" fill="#f8fbff">PowerShell · CLI</text>
              </g>
            </g>
          </g>

          <g transform="translate(880 350)">
            <rect x="0" y="0" width="270" height="220" rx="14" fill="rgba(226,236,246,.04)" stroke="rgba(226,236,246,.32)" stroke-width="1.2"/>
            <text x="14" y="22" font-family="'SFMono-Regular', Consolas, monospace" font-size="9.5" fill="rgba(226,236,246,.75)" letter-spacing="1.6">LOCAL MEMORY</text>
            <g font-family="Inter, system-ui, sans-serif" font-size="11.5" fill="#f2f7ff">
              <g transform="translate(14 42)">
                <text x="0" y="0" font-family="Georgia, serif" font-size="14" fill="#f8fbff">SQLite</text>
                <text x="0" y="18" font-size="11" fill="#cfd6e0">pka.db</text>
              </g>
              <g transform="translate(14 110)">
                <text x="0" y="0" font-family="Georgia, serif" font-size="14" fill="#f8fbff">Markdown · on disk</text>
                <text x="0" y="18" font-size="11" fill="#cfd6e0">Knowledge/ · Compass docs</text>
              </g>
              <g transform="translate(14 168)">
                <text x="0" y="0" font-family="Georgia, serif" font-size="14" fill="#f8fbff">OneDrive</text>
                <text x="0" y="18" font-size="11" fill="#cfd6e0">apps data · backup mirror</text>
              </g>
            </g>
          </g>
        </svg>
          <span class="system-zoom-hint" aria-hidden="true">Click to enlarge</span>
        </button>
      </div>
      <div class="system-lightbox" role="dialog" aria-modal="true" aria-label="PKA diagram enlarged">
        <button type="button" class="system-lightbox-close" aria-label="Close enlarged diagram">×</button>
        <div class="system-lightbox-svg-wrap"></div>
        <p class="system-lightbox-hint" aria-hidden="true">Click outside or press Esc to close</p>
      </div>
    </section>
    <section class="section" id="projects" aria-labelledby="projects-title">
      <p class="eyebrow">Projects</p>
      <h2 id="projects-title" class="main-title">Small systems, real use, public-safe case notes.</h2>
      <p class="section-kicker">Each project starts from a practical problem. Published work uses sanitized text, demo data, simplified diagrams and public-safe repositories rather than private source material.</p>
      <ProjectCarousel client:load />
    </section>
  </main>
  <footer class="footer"><span>© 2026 Mikhail Narbekov. All rights reserved.</span></footer>
</BaseLayout>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.system-diagram-zoom');
  const lightbox = document.querySelector<HTMLDivElement>('.system-lightbox');
  const wrap = document.querySelector<HTMLDivElement>('.system-lightbox-svg-wrap');
  const closeBtn = document.querySelector<HTMLButtonElement>('.system-lightbox-close');
  if (btn && lightbox && wrap && closeBtn) {
    const open = () => {
      const svg = btn.querySelector('svg');
      if (!svg) return;
      wrap.replaceChildren(svg.cloneNode(true) as Node);
      lightbox.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      lightbox.classList.remove('is-open');
      wrap.replaceChildren();
      document.body.style.overflow = '';
    };
    btn.addEventListener('click', open);
    closeBtn.addEventListener('click', (e) => { e.stopPropagation(); close(); });
    lightbox.addEventListener('click', (e) => { if (e.target === lightbox) close(); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && lightbox.classList.contains('is-open')) close();
    });
  }
</script>
