            <marker id="arrowR" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
              <polygon points="0 0, 8 3, 0 6" fill="rgba(159,203,255,.5)"/>
            </marker>
            <marker id="arrowH" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
              <polygon points="0 0, 8 3, 0 6" fill="rgba(180,255,200,.5)"/>
            </marker>
          </defs>

          <text x="100" y="34" text-anchor="middle" font-family="'SFMono-Regular', Consolas, monospace" font-size="9.5" fill="#8f9aaa" letter-spacing="2.2">HUMAN</text>
          <text x="285" y="34" text-anchor="middle" font-family="'SFMono-Regular', Consolas, monospace" font-size="9.5" fill="#8f9aaa" letter-spacing="2.2">COORDINATION</text>
          <text x="610" y="34" text-anchor="middle" font-family="'SFMono-Regular', Consolas, monospace" font-size="9.5" fill="#8f9aaa" letter-spacing="2.2">SPECIALISTS</text>
          <text x="965" y="34" text-anchor="middle" font-family="'SFMono-Regular', Consolas, monospace" font-size="9.5" fill="#8f9aaa" letter-spacing="2.2">TOOLS · MEMORY</text>

          <g stroke="rgba(226,236,246,.06)" stroke-width="1" fill="none">
