            <rect x="0" y="0" width="400" height="110" rx="14" fill="rgba(159,203,255,.04)" stroke="rgba(159,203,255,.32)" stroke-width="1"/>
            <text x="14" y="22" font-family="'SFMono-Regular', Consolas, monospace" font-size="9.5" fill="#9fcbff" letter-spacing="1.6">KNOWLEDGE</text>
            <g font-family="Inter, system-ui, sans-serif" font-size="11" fill="#f2f7ff">
              <g transform="translate(14 36)">
                <rect x="0" y="0" width="110" height="56" rx="9" fill="rgba(226,236,246,.04)" stroke="rgba(226,236,246,.18)" stroke-width="1"/>
