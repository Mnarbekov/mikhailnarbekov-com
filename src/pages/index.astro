                <text x="55" y="40" text-anchor="middle" font-size="9" fill="#8f9aaa" letter-spacing="1.4">SOURCES</text>
              </g>
              <g transform="translate(138 36)">
                <rect x="0" y="0" width="110" height="56" rx="9" fill="rgba(226,236,246,.04)" stroke="rgba(226,236,246,.18)" stroke-width="1"/>
