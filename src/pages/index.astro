            <text x="75" y="42" text-anchor="middle" font-family="Georgia, serif" font-size="17" fill="#f8fbff">Orchestrator</text>
            <text x="75" y="62" text-anchor="middle" font-family="'SFMono-Regular', Consolas, monospace" font-size="9" fill="#9fcbff" letter-spacing="1.6">DISPATCH</text>
            <line x1="20" y1="74" x2="130" y2="74" stroke="rgba(159,203,255,.25)" stroke-width="1"/>
            <text x="75" y="92" text-anchor="middle" font-family="Inter, system-ui, sans-serif" font-size="10.5" fill="#cfd6e0">parses brief</text>
            <text x="75" y="108" text-anchor="middle" font-family="Inter, system-ui, sans-serif" font-size="10.5" fill="#cfd6e0">picks specialist</text>
            <text x="75" y="124" text-anchor="middle" font-family="Inter, system-ui, sans-serif" font-size="10.5" fill="#cfd6e0">keeps context tidy</text>
          </g>
          <g stroke="rgba(159,203,255,.42)" stroke-width="1" fill="none">
            <line x1="380" y1="260" x2="432" y2="155" marker-end="url(#arrowR)"/>
            <line x1="380" y1="290" x2="432" y2="245" marker-end="url(#arrowR)"/>
            <line x1="380" y1="310" x2="432" y2="335" marker-end="url(#arrowR)"/>
            <line x1="380" y1="330" x2="432" y2="425" marker-end="url(#arrowR)"/>
